generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  email     String   @unique
  password  String
  role      Role     @default(USER)

  properties Property[]
  favorites  Favorite[]

  createdAt DateTime @default(now())
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String?   // TZ, KE, UG etc

  regions   Region[]

  createdAt DateTime  @default(now())
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String
  countryId Int

  country   Country   @relation(fields: [countryId], references: [id])

  districts District[]

  createdAt DateTime @default(now())

  @@unique([name, countryId])
}
model District {
  id        Int      @id @default(autoincrement())
  name      String
  regionId  Int

  region    Region   @relation(fields: [regionId], references: [id])

  wards     Ward[]

  createdAt DateTime @default(now())

  @@unique([name, regionId])
}
model Ward {
  id         Int      @id @default(autoincrement())
  name       String

  // 🌍 RELATION TO DISTRICT
  districtId Int
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  // 🏠 PROPERTIES IN THIS WARD
  properties Property[]

  // 🕒 TIMESTAMPS (recommended)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 🔒 Prevent duplicate ward names in same district
  @@unique([name, districtId])
  @@index([districtId])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  icon      String?

  properties Property[]

  createdAt DateTime   @default(now())
}


model Amenity {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?

  properties PropertyAmenity[]

  createdAt DateTime @default(now())
}

model Property {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  price       Float

  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)

  // 👤 OWNER
  userId      Int
  user        User @relation(fields: [userId], references: [id])

  // 🏷️ CATEGORY
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  // 🌍 ONLY ONE LOCATION FIELD (CLEAN)
  wardId      Int
  ward        Ward @relation(fields: [wardId], references: [id])

  // 🖼️ RELATIONS
  images      PropertyImage[]
  favorites   Favorite[]
  amenities   PropertyAmenity[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model PropertyImage {
  id         Int      @id @default(autoincrement())
  url        String

  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
}

model Favorite {
  id         Int @id @default(autoincrement())

  userId     Int
  propertyId Int

  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  OFFICE
  SHOP
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  RENTED
}


model PropertyAmenity {
  id         Int @id @default(autoincrement())

  propertyId Int
  amenityId  Int

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
}